// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String?
  isActive  Boolean  @default(true) @map("is_active")
  role      UserRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  teamMembers TeamMember[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

// Team model
model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  members       TeamMember[]
  serviceLines  TeamServiceLine[]
  specialties   TeamSpecialty[]
  clients       TeamClient[]

  @@map("teams")
}

// ServiceLine model
model ServiceLine {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  teams TeamServiceLine[]

  @@map("service_lines")
}

// Specialty model
model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  teams TeamSpecialty[]

  @@map("specialties")
}

// Client model
model Client {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  address     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  teams TeamClient[]

  @@map("clients")
}

// Junction table: Team - User (many-to-many)
model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      TeamMemberRole @default(MEMBER)
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

enum TeamMemberRole {
  LEADER
  MEMBER
}

// Junction table: Team - ServiceLine (many-to-many)
model TeamServiceLine {
  id            String   @id @default(uuid())
  teamId        String   @map("team_id")
  serviceLineId String   @map("service_line_id")
  assignedAt    DateTime @default(now()) @map("assigned_at")

  // Relations
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  serviceLine ServiceLine @relation(fields: [serviceLineId], references: [id], onDelete: Cascade)

  @@unique([teamId, serviceLineId])
  @@map("team_service_lines")
}

// Junction table: Team - Specialty (many-to-many)
model TeamSpecialty {
  id          String   @id @default(uuid())
  teamId      String   @map("team_id")
  specialtyId String   @map("specialty_id")
  assignedAt  DateTime @default(now()) @map("assigned_at")

  // Relations
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([teamId, specialtyId])
  @@map("team_specialties")
}

// Junction table: Team - Client (many-to-many)
model TeamClient {
  id         String   @id @default(uuid())
  teamId     String   @map("team_id")
  clientId   String   @map("client_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  isActive   Boolean  @default(true) @map("is_active")

  // Relations
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([teamId, clientId])
  @@map("team_clients")
}
